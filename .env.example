[TEMPLATE]
# Copy to .env and fill in only what you use. No secrets belong in git.

# Optional: JSON POST target for failed pipeline cycles (Slack/Discord-style
# incoming webhook or your own endpoint). Leave empty to log failures only.
LALIGA_ALERT_WEBHOOK=
LALIGA_ALERT_TIMEOUT=10

# FastAPI bind address (python main.py api).
LALIGA_API_HOST=127.0.0.1
LALIGA_API_PORT=8000

# Fixture discovery. TheSportsDB works with its free public key; API-Football
# requires an account key. Set LALIGA_FIXTURE_DISCOVERY=0 to disable all
# network fixture discovery and use the stored fixture file only.
LALIGA_FIXTURE_PROVIDER=thesportsdb
LALIGA_FIXTURE_DISCOVERY=1
LALIGA_FOOTBALL_API_KEY=
LALIGA_FOOTBALL_API_BASE=
LALIGA_FOOTBALL_LEAGUE_ID=

# Opt-in provider freshness/failure telemetry written by scheduled updates to
# data/processed/fixture_provider_status.json.
LALIGA_FIXTURE_TELEMETRY=0

# Prediction API cache. "memory" (default) needs no server; "redis" degrades to
# memory with a warning when Redis is unreachable; "none" disables caching.
LALIGA_CACHE_BACKEND=memory
LALIGA_CACHE_TTL=300
LALIGA_REDIS_URL=redis://localhost:6379/0

# Optional local feature-extract paths are configuration, not environment
# variables; see src/utils/config.py (data/raw/xg_history.csv and
# data/raw/player_availability.csv). Neither extract is committed.
